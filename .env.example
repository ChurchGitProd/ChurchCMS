# TinaCloud / TinaCMS Environment Variables (Required for Production Editing)
# Obtain these credentials from your Tina Cloud dashboard (https://app.tina.io)
NEXT_PUBLIC_TINA_CLIENT_ID=your_tina_client_id_here
TINA_TOKEN=your_tina_read_write_token_here
NEXT_PUBLIC_TINA_BRANCH=main

# Legacy aliases supported for backwards compatibility:
# GITHUB_CLIENT_ID=your_tina_client_id_here
# GITHUB_TOKEN=your_tina_read_write_token_here

# Site URL for metadata, sitemap.xml, and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# YouTube Data API v3 Key (Server-side only, optional)
# Used by /api/youtube/duration to automatically detect video durations in TinaCMS
# Leave empty or omitted to allow manual duration entry fallback
YOUTUBE_API_KEY=


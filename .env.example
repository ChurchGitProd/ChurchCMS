# TinaCMS / GitHub Production Environment Variables
# Obtain these credentials from your Tina Cloud dashboard (https://app.tina.io)
# or your configured Git-backed repository integration.

# Required: The TinaCMS Client ID (used by tinacms build and admin client)
GITHUB_CLIENT_ID=YOUR_TINA_CLIENT_ID

# Required: The TinaCMS Content API Token (read/write access)
GITHUB_TOKEN=YOUR_TINA_TOKEN

# Optional: Custom Git API URL (defaults to https://api.github.com if omitted)
# GITHUB_API_URL=https://api.github.com

# YouTube Data API v3 Key (Server-side only)
# Used by /api/youtube/duration to automatically detect video durations in TinaCMS
# Leave empty or omitted to allow manual duration entry fallback
YOUTUBE_API_KEY=

